# URL pública del sitio (para metadata, sitemap y Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (opcional mientras tanto: sin esto el sitio muestra todos los shows de la ticketera)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ticketera (Aplausos). Los valores por defecto ya apuntan al Rosita Ávila.
# APLAUSOS_API_URL=https://onlinesales-api.aplausos.com.ar
# APLAUSOS_TENANT_ORIGIN=https://entradas.smt.gob.ar
